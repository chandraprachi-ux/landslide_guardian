# =========================================================================
# Landslide Guardian SIH Prototype — Environment Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =========================================================================

# --- Storage --------------------------------------------------------------
# Leave MONGODB_URI empty to run in-memory prototype mode (no DB required).
MONGODB_URI=
# Human label for the database (used organisationally; connectivity is driven
# solely by MONGODB_URI).
DATABASE_URL=

# --- Admin authentication (CHANGE THESE before deployment) ---------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guardian-demo
# Secret used to sign admin session tokens (long random value).
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Email / SMTP (used for SOS alerts AND email OTP verification) -------
# Example: Gmail SMTP with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_FROM_EMAIL=you@gmail.com

# Aliases also honoured by the code:
# EMAIL_HOST / EMAIL_PORT / EMAIL_USERNAME / EMAIL_PASSWORD / EMAIL_FROM

# --- Email OTP verification ----------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Salt used to HMAC OTP digests. Generate a long random string and keep it.
OTP_SALT=change-me-to-a-long-random-salt

# --- Automatic regional monitoring & SOS ---------------------------------
# How often the background loop recomputes risk for all monitored regions.
MONITOR_INTERVAL_MINUTES=15
# Minimum minutes between automatic SOS emails to the SAME region (anti-spam).
SOS_COOLDOWN_MINUTES=60
